#: lib/common.sh:76
msgid ""
"Usage: sudo bash %s <command>\\n\\nCommands:\\n  base-create [OPTIONS]  "
"Download once and create a debootstrap package tarball\\n  base-info "
"TAR           Show the manifest of a base tarball\\n  network-"
"status          Show NAT network resources\\n  network-clean           Clean "
"NAT network resources\\n  init NAME [OPTIONS]     Create a container "
"image\\n  enter NAME [OPTIONS]    Enter a container\\n  exec NAME "
"[OPTIONS]     Execute a command in a container\\n  resize NAME [OPTIONS]   "
"Resize a container image\\n  status NAME             Show container "
"status\\n  list                    List all containers\\n  delete "
"NAME             Delete a container\\n\\ninit options:\\n  --tarball "
"PATH          Initialize from a local tarball\\n  --size SIZE             "
"Image size (default: 3G)\\n  --profile PATH          Copy an instance "
"profile\\n\\nresize options:\\n  --size SIZE             New image size; it "
"can only be increased\\n\\nbase-create options:\\n  --output PATH           "
"Output tarball path\\n  --manifest PATH         Manifest path (default: "
"TARBALL.manifest)\\n  --suite SUITE           Debian release\\n  --arch "
"ARCH             Target architecture\\n  --mirror URL            Debian "
"mirror URL\\n  --include PACKAGES      Packages to include, comma-"
"separated\\n  --exclude PACKAGES      Packages to exclude, comma-"
"separated\\n\\nnetwork options:\\n  --network MODE          Network mode: "
"none (default), host, or nat\\n\\nmount options:\\n  --mount SPEC            "
"Mount specification: HOST:CONTAINER[:ro|rw]\\n\\nprofile options:\\n  "
"network=MODE\\n  mount=HOST:CONTAINER[:ro|rw]\\n\\nenvironment variables:"
"\\n  DEBIAN_INSTANCES  Instance directory (default: current directory/"
"instances)\\n  DEBIAN_SIZE       Image size (default: 3G)\\n  "
"DEBIAN_LOCK_FILE  Lock file (default: /run/lock/debian-container.lock)\\n  "
"DEBIAN_TARBALL    Base tarball (default: current directory/debian-"
"base.tar.gz)\\n  DEBIAN_SUITE      Debian release (default: stable)\\n  "
"DEBIAN_ARCH       Target architecture\\n  DEBIAN_MIRROR     Debian mirror "
"URL\\n  DEBIAN_INCLUDE    Additional packages, comma-separated\\n  "
"DEBIAN_EXCLUDE    Packages to exclude, comma-separated\\n  DEBIAN_NETWORK    "
"Default network mode (default: none)\\n  DEBIAN_NAT_BRIDGE NAT bridge name "
"(default: rutils0)\\n  DEBIAN_NAT_NETWORK NAT subnet (default: "
"10.88.0.0/24)\\n  DEBIAN_NAT_GATEWAY NAT gateway address (default: "
"10.88.0.1)\\n  DEBIAN_NAT_ADDRESS Container address (default: 10.88.0.2)\\n  "
"DEBIAN_NAT_DNS     NAT mode DNS server (default: 1.1.1.1)\\n"
msgstr ""
"用法：sudo bash %s <命令>\\n\\n命令：\\n  base-create [选项]  下载一次并创建 debootstrap 软件包 tarball\\n  base-info TAR           查看基础 tarball 的 manifest\\n  network-status          查看 NAT 网络资源\\n  network-clean           清理 NAT 网络资源\\n  init NAME [选项]        创建指定名称的容器镜像\\n  enter NAME [选项]       进入指定容器\\n  exec NAME [选项]        在指定容器中执行命令\\n  resize NAME [选项]      扩大指定容器的镜像\\n  status NAME             查看容器状态\\n  list                    列出所有容器\\n  delete NAME             删除容器\\n\\ninit 选项：\\n  --tarball PATH          从本地 tarball 初始化\\n  --size SIZE             镜像大小（默认：3G）\\n  --profile PATH          复制实例 profile\\n\\nresize 选项：\\n  --size SIZE             新的镜像大小，只能扩大\\n\\nbase-create 选项：\\n  --output PATH           输出 tarball 路径\\n  --manifest PATH         manifest 路径（默认：TARBALL.manifest）\\n  --suite SUITE           Debian 版本\\n  --arch ARCH             目标架构\\n  --mirror URL            Debian 镜像地址\\n  --include PACKAGES      要加入的软件包，使用逗号分隔\\n  --exclude PACKAGES      要排除的软件包，使用逗号分隔\\n\\n网络选项：\\n  --network MODE          网络模式：none（默认）、host 或 nat\\n\\n挂载选项：\\n  --mount SPEC            目录挂载：HOST:CONTAINER[:ro|rw]\\n\\nprofile 配置项：\\n  network=MODE\\n  mount=HOST:CONTAINER[:ro|rw]\\n\\n环境变量：\\n  DEBIAN_INSTANCES  实例目录（默认：当前目录/instances）\\n  DEBIAN_SIZE       镜像大小（默认：3G）\\n  DEBIAN_LOCK_FILE  锁文件路径（默认：/run/lock/debian-container.lock）\\n  DEBIAN_TARBALL    基础 tarball（默认：当前目录/debian-base.tar.gz）\\n  DEBIAN_SUITE      Debian 版本（默认：stable）\\n  DEBIAN_ARCH       目标架构\\n  DEBIAN_MIRROR     Debian 镜像地址\\n  DEBIAN_INCLUDE    额外软件包，使用逗号分隔\\n  DEBIAN_EXCLUDE    要排除的软件包，使用逗号分隔\\n  DEBIAN_NETWORK    默认网络模式（默认：none）\\n  DEBIAN_NAT_BRIDGE NAT 网桥名称（默认：rutils0）\\n  DEBIAN_NAT_NETWORK NAT 子网（默认：10.88.0.0/24）\\n  DEBIAN_NAT_GATEWAY NAT 网关地址（默认：10.88.0.1）\\n  DEBIAN_NAT_ADDRESS 容器地址（默认：10.88.0.2）\\n  DEBIAN_NAT_DNS     NAT 模式 DNS（默认：1.1.1.1）\\n"

